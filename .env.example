# Infrastructure (values match docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/files
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# External API
EXTERNAL_API_BASE_URL=http://91.199.149.128:18001
# The identifier is single-use: once the catalog is fully downloaded, /names
# returns an empty list for it forever. Change the value to run the process again.
CANDIDATE_ID=change-me
EXTERNAL_TIMEOUT_S=30

# Request pacing: the exact rate limit of the external API is unknown, tune it here
EXTERNAL_MIN_INTERVAL_MS=1000
EXTERNAL_MIN_INTERVAL_MAX_MS=15000
MAX_RETRY_WAIT_S=1900
NETWORK_MAX_ATTEMPTS=5
NETWORK_BACKOFF_BASE_S=1

# Endless-loop guards
SINGLE_404_ATTEMPTS=2
MAX_STALE_ITERATIONS=3

# Archive validation
ZIP_MAX_ENTRY_BYTES=65536

# Run lock
RUN_LOCK_TTL_S=60
RUN_LOCK_HEARTBEAT_S=20
# A queued run holds no lock yet, so it is only given up on after this delay.
RUN_PENDING_GRACE_S=300
# A claimed run (status `starting`) has not taken the lock yet either, so it is
# judged by time as well — but it is already in a worker's hands and only has to
# acquire the lock, which is why the allowance is much shorter.
RUN_STARTING_GRACE_S=30

# How many trailing log entries GET /api/runs/current returns
RUN_EVENTS_TAIL=100

# Response limits
FILES_PAGE_SIZE_MAX=200
STATS_PAGE_SIZE_MAX=200
MAX_FILE_IDS=1000

# Presentation only: timestamps are stored and sorted in UTC and converted to this
# timezone at the UI boundary.
DISPLAY_TIMEZONE=Asia/Novosibirsk

# Test storage. The test database is created and migrated automatically; no extra
# infrastructure service is involved.
TEST_DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/files_test
TEST_REDIS_URL=redis://redis:6379/1
